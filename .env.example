# ScopeGrade AI — environment
#
# Copy this file to `.env.local` and fill in the two values from your Supabase
# project (Dashboard → Project Settings → API). Both are public, browser-safe
# keys: never put the service_role key in this file.
#
# `.env*` is gitignored, so `.env.local` stays on your machine.

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
